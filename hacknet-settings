        vol_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        vol_row.append(Gtk.Label(label="Output Volume (%):", xalign=0))
        self.vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 2)
        self.vol_scale.set_hexpand(True)
        self.vol_scale.set_value(self._get_volume_pct())
        self.vol_scale.connect("value-changed", self._on_vol_changed)
        vol_row.append(self.vol_scale)
        card.append(vol_row)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        mute_btn = Gtk.Button(label="Toggle Output Mute")
        mute_btn.add_css_class("secondary")
        mute_btn.connect("clicked", lambda *_: self._run_ctl(["hacknetctl", "volume", "mute"], "Toggled output mute"))
        btn_row.append(mute_btn)

        mic_btn = Gtk.Button(label="Toggle Mic Mute")
        mic_btn.add_css_class("secondary")
        mic_btn.connect("clicked", lambda *_: self._run_ctl(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"], "Toggled mic mute"))
        btn_row.append(mic_btn)
        card.append(btn_row)

        sink_lbl = Gtk.Label(label="Available Audio Sinks (pactl):", xalign=0)
        sink_lbl.add_css_class("muted")
        card.append(sink_lbl)

        self.sink_combo = Gtk.DropDown.new_from_strings(["Scanning..."])
        self.sink_names = []
        sink_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.sink_combo.set_hexpand(True)
        sink_row.append(self.sink_combo)
        set_sink = Gtk.Button(label="Set Default")
        set_sink.add_css_class("primary")
        set_sink.connect("clicked", self._apply_default_sink)
        sink_row.append(set_sink)
        card.append(sink_row)

        box.append(card)
        self._refresh_sinks()
        return scroll

    def _get_volume_pct(self):
        rc, out, _ = run_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        if rc == 0 and "Volume:" in out:
            try:
                return round(float(out.split()[1]) * 100)
            except Exception:
                pass
        return 50

    def _on_vol_changed(self, scale):
        pct = int(scale.get_value())
        run_cmd(["hacknetctl", "volume", str(pct)])

    def _refresh_sinks(self):
        rc, out, _ = run_cmd(["pactl", "list", "short", "sinks"])
        sinks = []
        if rc == 0:
            for line in out.splitlines():
                parts = line.split("\t")
                if len(parts) >= 2:
                    sinks.append(parts[1])
        self.sink_names = sinks
        self.sink_combo.set_model(Gtk.StringList.new(sinks or ["No audio sinks detected"]))

    def _apply_default_sink(self, *_):
        if not self.sink_names:
            return
        sink = self.sink_names[self.sink_combo.get_selected()]
        rc, _, err = run_cmd(["pactl", "set-default-sink", sink])
        self._set_status(f"Default sink: {sink}" if rc == 0 else err, rc == 0)

    # ------------------------------------------------------------ Network & Bluetooth
    def _build_network_page(self):
        scroll, box = scrolled_page()

        net_card = make_card("Network Interfaces & Radios")
        self.net_info = Gtk.Label(xalign=0, wrap=True)
        net_card.append(self.net_info)

        radio_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for label, cmd in [
            ("Wi-Fi On", ["nmcli", "radio", "wifi", "on"]),
            ("Wi-Fi Off", ["nmcli", "radio", "wifi", "off"]),
            ("Bluetooth On", ["bluetoothctl", "power", "on"]),
            ("Bluetooth Off", ["bluetoothctl", "power", "off"]),
        ]:
            b = Gtk.Button(label=label)
            b.add_css_class("secondary")
            b.connect("clicked", lambda _, c=cmd, l=label: self._net_action(c, l))
            radio_row.append(b)
        ref = Gtk.Button(label="Refresh")
        ref.add_css_class("secondary")
        ref.connect("clicked", lambda *_: self._refresh_network())
        radio_row.append(ref)
        net_card.append(radio_row)
        box.append(net_card)

        host_card = make_card("System Hostname")
        hrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.host_entry = Gtk.Entry(text=platform.node())
        self.host_entry.set_hexpand(True)
        hrow.append(self.host_entry)
        hbtn = Gtk.Button(label="Set Hostname")
        hbtn.add_css_class("primary")
        hbtn.connect("clicked", self._set_hostname)
        hrow.append(hbtn)
        host_card.append(hrow)
        box.append(host_card)

        self._refresh_network()
        return scroll

    def _net_action(self, cmd, label):
        rc, _, err = run_cmd(cmd)
        self._refresh_network()
        self._set_status(label if rc == 0 else err, rc == 0)

    def _refresh_network(self):
        rc, out, _ = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"])
        if rc == 0 and out:
            self.net_info.set_text(out)
        else:
            _, ip_out, _ = run_cmd(["ip", "-br", "addr"])
            self.net_info.set_text(ip_out or "No network interfaces detected.")

    def _set_hostname(self, *_):
        hn = self.host_entry.get_text().strip()
        if not hn:
            return
        rc, _, err = run_cmd(["pkexec", "hostnamectl", "set-hostname", hn])
        self._set_status(f"Hostname set to {hn}" if rc == 0 else err, rc == 0)

    # ------------------------------------------------------------ Keyboard & Mouse
    def _build_input_page(self):
        scroll, box = scrolled_page()
        cfg = {"layout": "us", "repeat_rate": 25, "repeat_delay": 300, "natural_scroll": False}
        if os.path.isfile(INPUT_JSON):
            try:
                cfg.update(json.load(open(INPUT_JSON)))
            except Exception:
                pass

        card = make_card("Keyboard & Pointer Settings")
        grid = Gtk.Grid(column_spacing=12, row_spacing=10)

        grid.attach(Gtk.Label(label="Keyboard Layout:", xalign=0), 0, 0, 1, 1)
        self.kb_layout_combo = Gtk.DropDown.new_from_strings(KEYMAP_LAYOUTS)
        if cfg["layout"] in KEYMAP_LAYOUTS:
            self.kb_layout_combo.set_selected(KEYMAP_LAYOUTS.index(cfg["layout"]))
        grid.attach(self.kb_layout_combo, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Repeat Rate (keys/sec):", xalign=0), 0, 1, 1, 1)
        self.rep_rate = Gtk.SpinButton.new_with_range(10, 100, 5)
        self.rep_rate.set_value(cfg["repeat_rate"])
        grid.attach(self.rep_rate, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label="Repeat Delay (ms):", xalign=0), 0, 2, 1, 1)
        self.rep_delay = Gtk.SpinButton.new_with_range(100, 1000, 50)
        self.rep_delay.set_value(cfg["repeat_delay"])
        grid.attach(self.rep_delay, 1, 2, 1, 1)

        self.nat_scroll = Gtk.CheckButton(label="Natural Scrolling (Touchpad / Mouse)", active=cfg["natural_scroll"])
        grid.attach(self.nat_scroll, 0, 3, 2, 1)
        card.append(grid)

        apply_btn = Gtk.Button(label="Apply & Save Input Settings")
        apply_btn.add_css_class("primary")
        apply_btn.connect("clicked", self._apply_input_settings)
        card.append(apply_btn)
        box.append(card)
        return scroll

    def _apply_input_settings(self, *_):
        layout = KEYMAP_LAYOUTS[self.kb_layout_combo.get_selected()]
        rate = int(self.rep_rate.get_value())
        delay = int(self.rep_delay.get_value())
        nat = self.nat_scroll.get_active()

        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(INPUT_JSON, "w") as f:
            json.dump({"layout": layout, "repeat_rate": rate, "repeat_delay": delay, "natural_scroll": nat}, f, indent=2)

        os.makedirs(os.path.dirname(SWAY_INPUT), exist_ok=True)
        with open(SWAY_INPUT, "w") as f:
            f.write(
                "# Managed by hacknet-settings\n"
                "input * {\n"
                f"    xkb_layout {layout}\n"
                f"    repeat_rate {rate}\n"
                f"    repeat_delay {delay}\n"
                f"    natural_scroll {'enabled' if nat else 'disabled'}\n"
                "}\n"
            )

        os.makedirs(os.path.dirname(HYPR_INPUT), exist_ok=True)
        with open(HYPR_INPUT, "w") as f:
            f.write(
                "-- Managed by hacknet-settings\n"
                "local hl = require('hyprland')\n"
                "hl.input = hl.input or {}\n"
                f"hl.input.kb_layout = \"{layout}\"\n"
                f"hl.input.repeat_rate = {rate}\n"
                f"hl.input.repeat_delay = {delay}\n"
            )

        reload_compositor()
        self._set_status(f"Applied input settings (layout={layout})", True)

    # ------------------------------------------------------------ Notifications
    def _build_notifications_page(self):
        scroll, box = scrolled_page()
        card = make_card("Notification Controls")
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for label, cmd in [
            ("Enable Do Not Disturb", ["hacknetctl", "dnd", "on"]),
            ("Disable Do Not Disturb", ["hacknetctl", "dnd", "off"]),
            ("Send Test Notification", ["hacknetctl", "notify", "HacknetOS Settings", "Test notification delivered"]),
        ]:
            b = Gtk.Button(label=label)
            b.add_css_class("secondary")
            b.connect("clicked", lambda _, c=cmd, l=label: self._run_ctl(c, l))
            row.append(b)
        card.append(row)
        box.append(card)
        return scroll

    # ------------------------------------------------------------ Date, Time & System
    def _build_system_page(self):
        scroll, box = scrolled_page()

        dt_card = make_card("Date, Time & Timezone")
        self.tz_lbl = Gtk.Label(xalign=0, wrap=True)
        dt_card.append(self.tz_lbl)

        tz_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        tz_row.append(Gtk.Label(label="Timezone:", xalign=0))
        self.tz_entry = Gtk.Entry(placeholder_text="America/New_York or UTC")
        self.tz_entry.set_hexpand(True)
        tz_row.append(self.tz_entry)
        tz_btn = Gtk.Button(label="Set Timezone")
        tz_btn.add_css_class("primary")
        tz_btn.connect("clicked", self._set_timezone)
        tz_row.append(tz_btn)
        dt_card.append(tz_row)
        box.append(dt_card)

        sys_card = make_card("System & User Info")
        _, mem_out, _ = run_cmd(["free", "-h"])
        _, df_out, _ = run_cmd(["df", "-h", "/"])
        sys_lbl = Gtk.Label(
            label=(
                f"User     : {os.environ.get('USER', 'unknown')}\n"
                f"Hostname : {platform.node()}\n"
                f"Kernel   : {platform.release()}\n"
                f"Arch     : {platform.machine()}\n\n"
                f"Memory:\n{mem_out}\n\n"
                f"Root Filesystem:\n{df_out}"
            ),
            xalign=0, wrap=True,
        )
        sys_card.append(sys_lbl)

        pw_btn = Gtk.Button(label="Change Account Password (Terminal)")
        pw_btn.add_css_class("secondary")
        pw_btn.connect("clicked", lambda *_: run_detached(["foot", "bash", "-lc", "passwd; read -rp 'Press Enter to close...'"]))
        sys_card.append(pw_btn)
        box.append(sys_card)

        self._refresh_datetime()
        return scroll

    def _refresh_datetime(self):
        rc, out, _ = run_cmd(["timedatectl", "status"])
        self.tz_lbl.set_text(out if rc == 0 else "timedatectl unavailable.")

    def _set_timezone(self, *_):
        tz = self.tz_entry.get_text().strip()
        if not tz:
            return
        rc, _, err = run_cmd(["pkexec", "timedatectl", "set-timezone", tz])
        self._refresh_datetime()
        self._set_status(f"Timezone set to {tz}" if rc == 0 else err, rc == 0)


def main():
    app = Gtk.Application(application_id="org.hacknetos.settings")
    app.connect("activate", lambda a: SettingsWindow(a).present())
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())
