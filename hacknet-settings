    def _on_kb_action_changed(self, *_):
        idx = self.kb_action.get_selected()
        self.kb_custom.set_visible(KEYBIND_PRESET_ACTIONS[idx][1] == "__custom__")

    def _on_add_keybind(self, *_):
        key = self.kb_key.get_text().strip()
        if not key:
            self._set_status("Enter a key name first", False)
            return
        mods = []
        if self.kb_super.get_active():
            mods.append("Super")
        if self.kb_ctrl.get_active():
            mods.append("Ctrl")
        if self.kb_alt.get_active():
            mods.append("Alt")
        if self.kb_shift.get_active():
            mods.append("Shift")

        idx = self.kb_action.get_selected()
        label, cmd = KEYBIND_PRESET_ACTIONS[idx]
        if cmd == "__custom__":
            cmd = self.kb_custom.get_text().strip()
            label = cmd
        if not cmd:
            self._set_status("Enter a custom command", False)
            return

        self._binds = [b for b in self._binds if not (b.get("mods") == mods and b.get("key") == key)]
        self._binds.append({"mods": mods, "key": key, "label": label, "command": cmd})
        self._save_and_apply_keybinds(self._binds)
        self._refresh_kb_list()

    def _refresh_kb_list(self):
        while child := self.kb_list_box.get_first_child():
            self.kb_list_box.remove(child)
        if not self._binds:
            lbl = Gtk.Label(label="No custom keybinds yet. Add one above.", xalign=0)
            lbl.add_css_class("muted")
            self.kb_list_box.append(lbl)
            return
        for idx, b in enumerate(self._binds):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            combo = "+".join(b.get("mods", []) + [b["key"]])
            txt = Gtk.Label(label=f"{combo}  →  {b['label']} ({b['command']})", xalign=0, wrap=True)
            txt.set_hexpand(True)
            row.append(txt)
            rm = Gtk.Button(label="Remove")
            rm.add_css_class("danger")
            rm.connect("clicked", lambda _, i=idx: self._remove_keybind(i))
            row.append(rm)
            self.kb_list_box.append(row)

    def _remove_keybind(self, idx: int):
        if 0 <= idx < len(self._binds):
            self._binds.pop(idx)
            self._save_and_apply_keybinds(self._binds)
            self._refresh_kb_list()

