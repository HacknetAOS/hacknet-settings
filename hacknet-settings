def run_cmd(cmd, check=False, timeout=3):
    try:
        res = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=check,
            timeout=timeout,
        )
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as exc:
        return 1, "", str(exc)


def run_detached(cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def compositor_backend():
    if os.environ.get("SWAYSOCK") or shutil.which("swaymsg") and run_cmd(["swaymsg", "-t", "get_version"])[0] == 0:
        return "sway"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or shutil.which("hyprctl") and run_cmd(["hyprctl", "version"])[0] == 0:
        return "hyprland"
    return "unknown"


def reload_compositor():
    b = compositor_backend()
    if b == "sway":
        run_cmd(["swaymsg", "reload"])
    elif b == "hyprland":
        run_cmd(["hyprctl", "reload"])


def make_card(title=None):
    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    card.add_css_class("card")
    if title:
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.add_css_class("section-title")
        card.append(lbl)
    return card


def scrolled_page():
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.set_vexpand(True)
    scroll.set_hexpand(True)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    box.set_margin_top(18)
    box.set_margin_bottom(24)
    box.set_margin_start(22)
    box.set_margin_end(22)
    scroll.set_child(box)
    return scroll, box


