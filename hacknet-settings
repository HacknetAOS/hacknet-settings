    # ------------------------------------------------------------ Keybinds
    def _load_keybinds(self):
        if os.path.isfile(KEYBINDS_JSON):
            try:
                data = json.load(open(KEYBINDS_JSON))
                if isinstance(data, list):
                    return data
            except Exception:
                pass
        return []

    def _save_and_apply_keybinds(self, binds):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(KEYBINDS_JSON, "w") as f:
            json.dump(binds, f, indent=2)

        os.makedirs(os.path.dirname(SWAY_BINDS), exist_ok=True)
        with open(SWAY_BINDS, "w") as f:
            f.write("# Managed by hacknet-settings\n")
            for b in binds:
                mods = [m.lower() for m in b.get("mods", [])]
                sway_mods = [("$mod" if m == "super" else "Mod1" if m == "alt" else "Control" if m == "ctrl" else "Shift") for m in mods]
                combo = "+".join(sway_mods + [b["key"]])
                f.write(f"bindsym {combo} exec {b['command']}\n")

        os.makedirs(os.path.dirname(HYPR_BINDS), exist_ok=True)
        with open(HYPR_BINDS, "w") as f:
            f.write("-- Managed by hacknet-settings\nlocal hl = require('hyprland')\n")
            for b in binds:
                mods = [m.upper() for m in b.get("mods", [])]
                combo = " + ".join(mods + [b["key"]])
                cmd_esc = b["command"].replace("\\", "\\\\").replace('"', '\\"')
                f.write(f'hl.bind("{combo}", hl.dsp.exec_cmd("{cmd_esc}"))\n')

        reload_compositor()
        self._set_status("Saved keybinds & reloaded compositor", True)

