    def _refresh_displays(self):
        b = compositor_backend()
        self._outputs = []
        lines = []
        if b == "sway":
            rc, out, _ = run_cmd(["swaymsg", "-t", "get_outputs", "-r"])
            if rc == 0:
                for o in json.loads(out):
                    r = o.get("rect", {})
                    self._outputs.append(o["name"])
                    lines.append(f"• {o['name']}: {r.get('width')}x{r.get('height')} (scale {o.get('scale', 1.0)})")
        elif b == "hyprland":
            rc, out, _ = run_cmd(["hyprctl", "monitors", "-j"])
            if rc == 0:
                for m in json.loads(out):
                    self._outputs.append(m["name"])
                    lines.append(f"• {m['name']}: {m.get('width')}x{m.get('height')}@{m.get('refreshRate')}Hz (scale {m.get('scale', 1.0)})")
        self.disp_info.set_text("\n".join(lines) if lines else "No compositor output information available.")

    def _apply_display_scale(self, *_):
        scales = ["1.0", "1.25", "1.5", "2.0"]
        sc = scales[self.scale_combo.get_selected()]
        b = compositor_backend()
        for name in getattr(self, "_outputs", []):
            if b == "sway":
                run_cmd(["swaymsg", "output", name, "scale", sc])
            elif b == "hyprland":
                run_cmd(["hyprctl", "keyword", "monitor", f"{name},preferred,auto,{sc}"])
        self._refresh_displays()
        self._set_status(f"Applied display scale {sc}", True)

